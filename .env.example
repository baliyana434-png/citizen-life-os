# ==========================================
# GOOGLE FIREBASE CONFIG
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ==========================================
# INDIAN REAL SMS GATEWAY (FAST2SMS / 2FACTOR)
# Sends 100% Real Telecom SMS to any Jio/Airtel/Vi number
# Get your free key in 1 min from https://www.fast2sms.com (Dev API)
# ==========================================
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWO_FACTOR_API_KEY=your_2factor_api_key_here

# ==========================================
# EMAIL & SMTP CONFIGURATION (GMAIL / RESEND / BREVO)
# Dispatches 100% Real Password Reset Emails & Verification Codes to Gmail inboxes
# ==========================================
# Option 1: Gmail SMTP (Free & Instant)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Generate 16-char App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password
SMTP_FROM="Citizen Life OS <your_email@gmail.com>"

# Option 2: Resend REST API (resend.com)
RESEND_API_KEY=

# Option 3: Brevo REST API (brevo.com)
BREVO_API_KEY=

